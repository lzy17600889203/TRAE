---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>3D 模型切片与打印路径生成模拟系统</title>
  </head>
  <body>
    <div id="app">
      <header>
        <h1>3D 模型切片与打印路径生成模拟系统</h1>
        <div class="subtitle">Astro + WebGL + FastAPI</div>
      </header>
      
      <main class="main-container">
        <aside class="sidebar">
          <div class="panel">
            <h3>模型导入</h3>
            <select id="modelSelect">
              <option value="cube">立方体</option>
              <option value="sphere">球体</option>
              <option value="cylinder">圆柱体</option>
              <option value="cone">圆锥体</option>
              <option value="torus">圆环体</option>
              <option value="overhang">悬臂结构（用于测试塌陷）</option>
            </select>
            <button id="importModel" class="btn">加载模型</button>
          </div>

          <div class="panel">
            <h3>预设场景</h3>
            <button class="preset-btn preset-standard" data-preset="standard">
              🟢 标准填充预设
            </button>
            <button class="preset-btn preset-hollow" data-preset="hollow">
              🔵 空心外壳预设
            </button>
            <button class="preset-btn preset-missing-support" data-preset="missing_support">
              🟠 支撑缺失预设
            </button>
            <button class="preset-btn preset-fast-jitter" data-preset="fast_jitter">
              🔴 高速抖动预设
            </button>
          </div>

          <div class="panel">
            <h3>打印参数</h3>
            
            <div class="control-group">
              <label>层高 (mm)</label>
              <input type="range" id="layerHeight" min="0.05" max="0.3" step="0.01" value="0.2" />
              <span id="layerHeightValue">0.2</span>
            </div>

            <div class="control-group">
              <label>填充密度 (%)</label>
              <input type="range" id="infillDensity" min="0" max="100" step="5" value="20" />
              <span id="infillDensityValue">20</span>
            </div>

            <div class="control-group">
              <label>打印速度 (mm/s)</label>
              <input type="range" id="printSpeed" min="20" max="200" step="10" value="80" />
              <span id="printSpeedValue">80</span>
            </div>

            <div class="control-group">
              <label>支撑结构</label>
              <select id="supportStyle">
                <option value="none">无支撑</option>
                <option value="grid">网格支撑</option>
                <option value="tree">树形支撑</option>
                <option value="line">线形支撑</option>
              </select>
            </div>
          </div>

          <div class="panel">
            <h3>动画控制</h3>
            <div class="btn-group">
              <button id="startSlice" class="btn btn-primary">开始切片</button>
              <button id="startPrint" class="btn btn-success">开始打印</button>
              <button id="pausePrint" class="btn btn-warning">暂停</button>
              <button id="resetScene" class="btn btn-danger">重置</button>
            </div>
            
            <div class="control-group">
              <label>动画速度</label>
              <input type="range" id="animationSpeed" min="0.1" max="3" step="0.1" value="1" />
              <span id="animationSpeedValue">1.0x</span>
            </div>
          </div>

          <div class="panel">
            <h3>显示选项</h3>
            <div class="checkbox-group">
              <label><input type="checkbox" id="showModel" checked /> 显示模型</label>
              <label><input type="checkbox" id="showSlices" /> 显示切片</label>
              <label><input type="checkbox" id="showPaths" checked /> 显示打印路径</label>
              <label><input type="checkbox" id="showSupports" checked /> 显示支撑</label>
              <label><input type="checkbox" id="showInfill" checked /> 显示填充</label>
              <label><input type="checkbox" id="showErrors" checked /> 高亮错误</label>
              <label><input type="checkbox" id="showNozzle" checked /> 显示喷头</label>
            </div>
          </div>
        </aside>

        <section class="viewport">
          <div id="canvas-container"></div>
          <div class="info-panel">
            <div class="info-item">
              <span class="label">当前层:</span>
              <span id="currentLayer">0</span> / <span id="totalLayers">0</span>
            </div>
            <div class="info-item">
              <span class="label">打印进度:</span>
              <span id="progress">0%</span>
            </div>
            <div class="info-item">
              <span class="label">G-code 行数:</span>
              <span id="gcodeCount">0</span>
            </div>
            <div class="info-item">
              <span class="label">空驶距离:</span>
              <span id="travelDistance">0</span> mm
            </div>
            <div class="info-item status" id="statusIndicator">
              <span class="status-dot"></span>
              <span id="statusText">就绪</span>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  
  let scene = null;
  let camera = null;
  let renderer = null;
  let controls = null;
  let modelMesh = null;
  let currentModel = null;
  let currentSliceResult = null;
  let isPrinting = false;
  let isPaused = false;
  let lastTime = 0;
  let animationId = null;
  let animationProgress = 0;
  let animationSpeed = 1;
  let nozzle = null;
  let printedGroup = null;
  let totalPaths = 0;
  let pathLines = [];
  let errorLines = [];
  let supportLines = [];
  let infillLines = [];

  const DEFAULT_PARAMS = {
  layerHeight: 0.2,
      infillDensity: 20,
      printSpeed: 80,
      supportStyle: 'none',
      infillPattern: 'line',
      nozzleDiameter: 0.4,
      extrusionWidth: 0.44,
      enableErrors: true,
    };

    const PRESETS = {
      standard: { layerHeight: 0.2, infillDensity: 20, printSpeed: 80, supportStyle: 'none', enableErrors: false, model: 'cube' },
      hollow: { layerHeight: 0.15, infillDensity: 0, printSpeed: 60, supportStyle: 'grid', enableErrors: false, model: 'sphere' },
      missing_support: { layerHeight: 0.2, infillDensity: 15, printSpeed: 100, supportStyle: 'none', enableErrors: true, model: 'overhang' },
      fast_jitter: { layerHeight: 0.3, infillDensity: 50, printSpeed: 200, supportStyle: 'none', enableErrors: true, model: 'torus' },
    };

    let parameters = { ...DEFAULT_PARAMS };

    function dist2D(a, b) {
      const dx = a.x - b.x;
      const dz = a.y - b.y;
      return Math.sqrt(dx * dx + dz * dz);
    }

    function dist3D(a, b) {
      const dx = a.x - b.x;
      const dy = a.y - b.y;
      const dz = a.z - b.z;
      return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    function createCube(size = 2) {
      const half = size / 2;
      const vertices = [
        { x: -half, y: -half, z: -half },
        { x: half, y: -half, z: -half },
        { x: half, y: half, z: -half },
        { x: -half, y: half, z: -half },
        { x: -half, y: -half, z: half },
        { x: half, y: -half, z: half },
        { x: half, y: half, z: half },
        { x: -half, y: half, z: half },
      ];
      
      const triangles = [
        [0, 1, 2], [0, 2, 3],
        [4, 6, 5], [4, 7, 6],
        [0, 4, 5], [0, 5, 1],
        [2, 6, 7], [2, 7, 3],
        [0, 3, 7], [0, 7, 4],
        [1, 5, 6], [1, 6, 2],
      ];

      return {
        type: 'cube',
        vertices,
        triangles,
        bounds: {
          min: { x: -half, y: -half, z: -half },
          max: { x: half, y: half, z: half },
        },
      };
    }

    function createSphere(radius = 1.2, segments = 20) {
      const vertices = [];
      const triangles = [];

      for (let lat = 0; lat <= segments; lat++) {
        const theta = (lat * Math.PI) / segments;
        const sinTheta = Math.sin(theta);
        const cosTheta = Math.cos(theta);

        for (let lon = 0; lon <= segments; lon++) {
          const phi = (lon * 2 * Math.PI) / segments;
          vertices.push({
            x: radius * Math.cos(phi) * sinTheta,
            y: radius * cosTheta,
            z: radius * Math.sin(phi) * sinTheta,
          });
        }
      }

      for (let lat = 0; lat < segments; lat++) {
        for (let lon = 0; lon < segments; lon++) {
          const first = lat * (segments + 1) + lon;
          const second = first + segments + 1;
          triangles.push([first, second, first + 1]);
          triangles.push([second, second + 1, first + 1]);
        }
      }

      return {
        type: 'sphere',
        vertices,
        triangles,
        bounds: {
          min: { x: -radius, y: -radius, z: -radius },
          max: { x: radius, y: radius, z: radius },
        },
      };
    }

    function createCylinder(radius = 1, height = 2.5, segments = 24) {
      const vertices = [];
      const triangles = [];

      const bottomCenter = { x: 0, y: -height / 2, z: 0 };
      const topCenter = { x: 0, y: height / 2, z: 0 };
      vertices.push(bottomCenter, topCenter);

      for (let i = 0; i <= segments; i++) {
        const angle = (i * 2 * Math.PI) / segments;
        const x = radius * Math.cos(angle);
        const z = radius * Math.sin(angle);
        vertices.push({ x, y: -height / 2, z });
        vertices.push({ x, y: height / 2, z });
      }

      for (let i = 0; i < segments; i++) {
        const b1 = 2 + i * 2;
        const b2 = 2 + (i + 1) * 2;
        const t1 = b1 + 1;
        const t2 = b2 + 1;

        triangles.push([0, b1, b2]);
        triangles.push([1, t2, t1]);
        triangles.push([b1, t1, t2]);
        triangles.push([b1, t2, b2]);
      }

      return {
        type: 'cylinder',
        vertices,
        triangles,
        bounds: {
          min: { x: -radius, y: -height / 2, z: -radius },
          max: { x: radius, y: height / 2, z: radius },
        },
      };
    }

    function createTorus(R = 1.0, r = 0.4, segmentsT = 32, segmentsP = 16) {
      const vertices = [];
      const triangles = [];

      for (let i = 0; i <= segmentsT; i++) {
        const u = (i / segmentsT) * Math.PI * 2;
        for (let j = 0; j <= segmentsP; j++) {
          const v = (j / segmentsP) * Math.PI * 2;
          vertices.push({
            x: (R + r * Math.cos(v)) * Math.cos(u),
            y: r * Math.sin(v),
            z: (R + r * Math.cos(v)) * Math.sin(u),
          });
        }
      }

      for (let i = 0; i < segmentsT; i++) {
        for (let j = 0; j < segmentsP; j++) {
          const a = i * (segmentsP + 1) + j;
          const b = a + segmentsP + 1;
          triangles.push([a, b, a + 1]);
          triangles.push([b, b + 1, a + 1]);
        }
      }

      return {
        type: 'torus',
        vertices,
        triangles,
        bounds: {
          min: { x: -(R + r), y: -r, z: -(R + r) },
          max: { x: R + r, y: r, z: R + r },
        },
      };
    }

    function createOverhang() {
      const vertices = [];
      const triangles = [];

      const baseX = 0.8;
      const baseY = 1.0;
      const baseZ = 0.8;
      const overhangLength = 1.5;
      const overhangThickness = 0.3;

      const baseMin = { x: -baseX, y: -1.2, z: -baseZ };
      const baseMax = { x: baseX, y: -1.2 + baseY, z: baseZ };

      vertices.push(
        { x: baseMin.x, y: baseMin.y, z: baseMin.z },
        { x: baseMax.x, y: baseMin.y, z: baseMin.z },
        { x: baseMax.x, y: baseMax.y, z: baseMin.z },
        { x: baseMin.x, y: baseMax.y, z: baseMin.z },
        { x: baseMin.x, y: baseMin.y, z: baseMax.z },
        { x: baseMax.x, y: baseMin.y, z: baseMax.z },
        { x: baseMax.x, y: baseMax.y, z: baseMax.z },
        { x: baseMin.x, y: baseMax.y, z: baseMax.z }
      );

      const baseFaces = [
        [0, 1, 2], [0, 2, 3],
        [4, 6, 5], [4, 7, 6],
        [0, 4, 5], [0, 5, 1],
        [2, 6, 7], [2, 7, 3],
        [0, 3, 7], [0, 7, 4],
        [1, 5, 6], [1, 6, 2],
      ];
      triangles.push(...baseFaces);

      const ohY = baseMax.y;
      const ohStartX = -baseX + 0.2;
      const ohEndX = ohStartX + overhangLength;
      const ohWidth = 1.0;

      const ohVertices = [
        { x: ohStartX, y: ohY, z: -ohWidth / 2 },
        { x: ohEndX, y: ohY, z: -ohWidth / 2 },
        { x: ohEndX, y: ohY + overhangThickness, z: -ohWidth / 2 },
        { x: ohStartX, y: ohY + overhangThickness, z: -ohWidth / 2 },
        { x: ohStartX, y: ohY, z: ohWidth / 2 },
        { x: ohEndX, y: ohY, z: ohWidth / 2 },
        { x: ohEndX, y: ohY + overhangThickness, z: ohWidth / 2 },
        { x: ohStartX, y: ohY + overhangThickness, z: ohWidth / 2 },
      ];

      const baseIdx = vertices.length;
      vertices.push(...ohVertices);

      const ohFaces = [
        [baseIdx + 0, baseIdx + 1, baseIdx + 2],
        [baseIdx + 0, baseIdx + 2, baseIdx + 3],
        [baseIdx + 4, baseIdx + 6, baseIdx + 5],
        [baseIdx + 4, baseIdx + 7, baseIdx + 6],
        [baseIdx + 0, baseIdx + 4, baseIdx + 5],
        [baseIdx + 0, baseIdx + 5, baseIdx + 1],
        [baseIdx + 2, baseIdx + 6, baseIdx + 7],
        [baseIdx + 2, baseIdx + 7, baseIdx + 3],
        [baseIdx + 0, baseIdx + 3, baseIdx + 7],
        [baseIdx + 0, baseIdx + 7, baseIdx + 4],
        [baseIdx + 1, baseIdx + 5, baseIdx + 6],
        [baseIdx + 1, baseIdx + 6, baseIdx + 2],
      ];
      triangles.push(...ohFaces);

      return {
        type: 'overhang',
        vertices,
        triangles,
        bounds: {
          min: { x: ohStartX, y: baseMin.y, z: -ohWidth / 2 },
          max: { x: ohEndX, y: ohY + overhangThickness, z: ohWidth / 2 },
        },
      };
    }

    function createCone(radius = 1.2, height = 2.5, segments = 24) {
      const vertices = [];
      const triangles = [];

      const bottomCenter = { x: 0, y: -height / 2, z: 0 };
      const apex = { x: 0, y: height / 2, z: 0 };
      vertices.push(bottomCenter, apex);

      for (let i = 0; i <= segments; i++) {
        const angle = (i * 2 * Math.PI) / segments;
        const x = radius * Math.cos(angle);
        const z = radius * Math.sin(angle);
        vertices.push({ x, y: -height / 2, z });
      }

      for (let i = 0; i < segments; i++) {
        const p1 = 2 + i;
        const p2 = 2 + i + 1;
        triangles.push([0, p1, p2]);
        triangles.push([1, p2, p1]);
      }

      return {
        type: 'cone',
        vertices,
        triangles,
        bounds: {
          min: { x: -radius, y: -height / 2, z: -radius },
          max: { x: radius, y: height / 2, z: radius },
        },
      };
    }

    function generateModel(type) {
      switch (type) {
        case 'cube': return createCube();
        case 'sphere': return createSphere();
        case 'cylinder': return createCylinder();
        case 'cone': return createCone();
        case 'torus': return createTorus();
        case 'overhang': return createOverhang();
        default: return createCube();
      }
    }

    function intersectTriangle(v0, v1, v2, planeY, epsilon = 1e-6) {
      const points = [];
      const vertices = [v0, v1, v2, v0];

      for (let i = 0; i < 3; i++) {
        const a = vertices[i];
        const b = vertices[i + 1];
        const ya = a.y;
        const yb = b.y;

        if (Math.abs(ya - planeY) < epsilon) {
          points.push({ x: a.x, y: a.z });
          continue;
        }
        if (Math.abs(yb - planeY) < epsilon) {
          points.push({ x: b.x, y: b.z });
          continue;
        }
        if ((ya - planeY) * (yb - planeY) < 0) {
          const t = (planeY - ya) / (yb - ya);
          points.push({
            x: a.x + t * (b.x - a.x),
            y: a.z + t * (b.z - a.z),
          });
        }
      }
      return points;
    }

    function createContours(points, epsilon = 1e-4) {
      const contours = [];
      const used = new Set();
      const n = points.length;
      if (n < 2) return contours;

      for (let startIdx = 0; startIdx < n; startIdx++) {
        if (used.has(startIdx)) continue;

        const contour = [points[startIdx]];
        used.add(startIdx);
        let currentIdx = startIdx;

        while (true) {
          let closestIdx = -1;
          let closestDist = Infinity;

          for (let i = 0; i < n; i++) {
            if (used.has(i)) continue;
            const d = dist2D(points[currentIdx], points[i]);
            if (d < closestDist) {
              closestDist = d;
              closestIdx = i;
            }
          }

          if (closestIdx === -1 || closestDist > 0.5) break;
          contour.push(points[closestIdx]);
          used.add(closestIdx);
          currentIdx = closestIdx;

          if (contour.length > 1 && dist2D(contour[0], contour[contour.length - 1]) < epsilon) {
            contour.pop();
            break;
          }
        }
        if (contour.length >= 3) contours.push(contour);
      }
      return contours;
    }

    function isPointInPolygon(p, polygon) {
      let inside = false;
      const n = polygon.length;
      for (let i = 0, j = n - 1; i < n; j = i++) {
        const xi = polygon[i].x, yi = polygon[i].y;
        const xj = polygon[j].x, yj = polygon[j].y;
        if ((yi > p.y) !== (yj > p.y)) {
          const xIntersect = ((p.y - yi) * (xj - xi)) / (yj - yi) + xi;
          if (p.x < xIntersect) inside = !inside;
        }
      }
      return inside;
    }

    function generateInfill(contours, density, angle = 45) {
      if (density <= 0 || contours.length === 0) return [];
      const lines = [];
      const spacing = 0.1 / (density / 100);
      
      const allPoints = contours.flat();
      const minX = Math.min(...allPoints.map(p => p.x)) - 0.1;
      const maxX = Math.max(...allPoints.map(p => p.x)) + 0.1;
      const minY = Math.min(...allPoints.map(p => p.y)) - 0.1;
      const maxY = Math.max(...allPoints.map(p => p.y)) + 0.1;

      const rad = (angle * Math.PI) / 180;
      const cosA = Math.cos(rad);
      const sinA = Math.sin(rad);
      const outer = contours[0];
      const diag = Math.sqrt((maxX - minX) ** 2 + (maxY - minY) ** 2);
      const centerX = (minX + maxX) / 2;
      const centerY = (minY + maxY) / 2;

      for (let i = -Math.ceil(diag / spacing); i <= Math.ceil(diag / spacing); i++) {
        const offset = i * spacing;
        const lineStart = { x: centerX + offset * cosA - diag * sinA, y: centerY + offset * sinA + diag * cosA };
        const lineEnd = { x: centerX + offset * cosA + diag * sinA, y: centerY + offset * sinA - diag * cosA };
        const intersections = [];
        const n = outer.length;

        for (let j = 0; j < n; j++) {
          const p1 = outer[j];
          const p2 = outer[(j + 1) % n];
          const denom = (lineStart.x - lineEnd.x) * (p1.y - p2.y) - (lineStart.y - lineEnd.y) * (p1.x - p2.x);
          if (Math.abs(denom) < 1e-10) continue;
          const t = ((lineStart.x - p1.x) * (p1.y - p2.y) - (lineStart.y - p1.y) * (p1.x - p2.x)) / denom;
          const u = -((lineStart.x - lineEnd.x) * (lineStart.y - p1.y) - (lineStart.y - lineEnd.y) * (lineStart.x - p1.x)) / denom;
          if (t >= 0 && t <= 1 && u >= 0 && u <= 1) {
            intersections.push({
              x: lineStart.x + t * (lineEnd.x - lineStart.x),
              y: lineStart.y + t * (lineEnd.y - lineStart.y),
            });
          }
        }

        if (intersections.length >= 2) {
          intersections.sort((a, b) => {
            const da = (a.x - lineStart.x) * sinA - (a.y - lineStart.y) * cosA;
            const db = (b.x - lineStart.x) * sinA - (b.y - lineStart.y) * cosA;
            return da - db;
          });
          for (let k = 0; k < intersections.length - 1; k += 2) {
            if (k + 1 < intersections.length) {
              const mid = { x: (intersections[k].x + intersections[k + 1].x) / 2, y: (intersections[k].y + intersections[k + 1].y) / 2 };
              if (isPointInPolygon(mid, outer)) {
                lines.push([intersections[k], intersections[k + 1]]);
              }
            }
          }
        }
      }
      return lines;
    }

    function generateSupport(contours, style) {
      if (style === 'none' || contours.length === 0) return [];
      const supports = [];
      const outer = contours[0];

      if (style === 'grid') {
        const gridSize = 0.15;
        const minX = Math.min(...outer.map(p => p.x));
        const maxX = Math.max(...outer.map(p => p.x));
        const minY = Math.min(...outer.map(p => p.y));
        const maxY = Math.max(...outer.map(p => p.y));

        for (let x = minX; x <= maxX; x += gridSize) {
          const line = [];
          for (let y = minY; y <= maxY; y += 0.05) {
            if (isPointInPolygon({ x, y }, outer)) line.push({ x, y });
          }
          if (line.length >= 2) supports.push(line);
        }
        for (let y = minY; y <= maxY; y += gridSize) {
          const line = [];
          for (let x = minX; x <= maxX; x += 0.05) {
            if (isPointInPolygon({ x, y }, outer)) line.push({ x, y });
          }
          if (line.length >= 2) supports.push(line);
        }
      }
      return supports;
    }

    function sliceModel(model, params) {
      const layers = [];
      const errors = [];
      let totalGcode = 0;
      let totalTravel = 0;

      const minY = model.bounds.min.y;
      const maxY = model.bounds.max.y;
      const height = maxY - minY;
      const numLayers = Math.ceil(height / params.layerHeight);
      const isOverhang = model.type === 'overhang';
      const hasSupport = params.supportStyle !== 'none';

      for (let layerIdx = 0; layerIdx < numLayers; layerIdx++) {
        const z = minY + layerIdx * params.layerHeight + params.layerHeight / 2;
        const slicePoints = [];

        for (const tri of model.triangles) {
          const v0 = model.vertices[tri[0]];
          const v1 = model.vertices[tri[1]];
          const v2 = model.vertices[tri[2]];
          slicePoints.push(...intersectTriangle(v0, v1, v2, z));
        }

        const contours = createContours(slicePoints);
        let infill = [];
        if (params.infillDensity > 0 && contours.length > 0) {
          const angle = layerIdx % 2 === 0 ? 45 : -45;
          infill = generateInfill(contours, params.infillDensity, angle);
        }

        let supportContours = [];
        if (hasSupport && contours.length > 0) {
          supportContours = generateSupport(contours, params.supportStyle);
        }

        const paths = [];
        for (const contour of contours) {
          if (contour.length < 3) continue;
          const points3D = contour.map(p => ({ x: p.x, y: z, z: p.y }));
          points3D.push(points3D[0]);
          paths.push({ type: 'perimeter', points: points3D, layerIndex: layerIdx, isError: false });
        }
        for (const line of infill) {
          if (line.length < 2) continue;
          paths.push({ type: 'infill', points: line.map(p => ({ x: p.x, y: z, z: p.y })), layerIndex: layerIdx, isError: false });
        }
        for (const line of supportContours) {
          if (line.length < 2) continue;
          paths.push({ type: 'support', points: line.map(p => ({ x: p.x, y: z, z: p.y })), layerIndex: layerIdx, isError: false });
        }

        if (
          isOverhang &&
          !hasSupport &&
          z > -0.5 &&
          params.enableErrors
        ) {
          for (const path of paths) {
            if (path.type === 'perimeter' && path.points.length > 2 && z > -0.3) {
              path.isError = true;
              path.errorType = 'overhang_collapse';
            }
          }
        }

        for (const path of paths) {
          if (path.points.length >= 2) {
            totalGcode++;
            totalTravel += dist3D(path.points[0], path.points[path.points.length - 1]);
          }
        }

        layers.push({
          layerIndex: layerIdx,
          z,
          contours,
          infillPattern: infill,
          supportContours,
          paths,
        });
      }

      return {
        model,
        parameters: params,
        layers,
        totalGcodeLines: totalGcode,
        totalTravelDistance: totalTravel * 10,
        errors,
        hasSupport,
      };
    }

    function createLineGeometry(points) {
      const positions = [];
      for (const p of points) {
        positions.push(p.x, p.y, p.z);
      }
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      return geometry;
    }

    function createLineMaterial(color, opacity = 1, isError = false) {
      return new THREE.LineBasicMaterial({
        color,
        transparent: opacity < 1,
        opacity,
        linewidth: isError ? 3 : 1,
      });
    }

    function loadModelToScene(model) {
      if (modelMesh) {
        scene.remove(modelMesh);
        modelMesh.geometry.dispose();
        modelMesh.material.dispose();
      }

      const geometry = new THREE.BufferGeometry();
      const positions = [];
      const normals = [];

      for (const tri of model.triangles) {
        const v0 = model.vertices[tri[0]];
        const v1 = model.vertices[tri[1]];
        const v2 = model.vertices[tri[2]];

        positions.push(v0.x, v0.y, v0.z, v1.x, v1.y, v1.z, v2.x, v2.y, v2.z);

        const ax = v1.x - v0.x, ay = v1.y - v0.y, az = v1.z - v0.z;
        const bx = v2.x - v0.x, by = v2.y - v0.y, bz = v2.z - v0.z;
        const nx = ay * bz - az * by;
        const ny = az * bx - ax * bz;
        const nz = ax * by - ay * bx;
        const len = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;

        for (let i = 0; i < 3; i++) {
          normals.push(nx / len, ny / len, nz / len);
        }
      }

      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('normal', new THREE.Float32BufferAttribute(normals, 3));
      geometry.computeVertexNormals();

      const material = new THREE.MeshStandardMaterial({
        color: 0x4a69bd,
        transparent: true,
        opacity: 0.7,
        roughness: 0.5,
        metalness: 0.3,
      });

      modelMesh = new THREE.Mesh(geometry, material);
      modelMesh.castShadow = true;
      scene.add(modelMesh);
    }

    function clearPaths() {
      [...pathLines, ...errorLines, ...supportLines, ...infillLines].forEach(line => {
        scene.remove(line);
        line.geometry.dispose();
        line.material.dispose();
      });
      pathLines = [];
      errorLines = [];
      supportLines = [];
      infillLines = [];
    }

    function showPaths(sliceResult, options = {}) {
      clearPaths();
      const opt = { showPerimeter: true, showInfill: true, showSupport: true, showErrors: true, ...options };
      totalPaths = 0;

      for (const layer of sliceResult.layers) {
        for (const path of layer.paths) {
          totalPaths++;
          if (path.points.length < 2) continue;

          const geometry = createLineGeometry(path.points);
          let color = 0x00b894;
          let isError = path.isError || false;
          let targetArray = pathLines;

          if (isError && opt.showErrors) {
            color = 0xe74c3c;
            targetArray = errorLines;
          } else if (path.type === 'perimeter' && opt.showPerimeter) {
            color = 0x00b894;
          } else if (path.type === 'infill' && opt.showInfill) {
            color = 0x6c5ce7;
            targetArray = infillLines;
          } else if (path.type === 'support' && opt.showSupport) {
            color = 0xfdcb6e;
            targetArray = supportLines;
          } else {
            geometry.dispose();
            continue;
          }

          const material = createLineMaterial(color, isError ? 1 : 0.7, isError);
          const line = new THREE.Line(geometry, material);
          scene.add(line);
          targetArray.push(line);
        }
      }
    }

    function resetAnimation() {
      animationProgress = 0;
      if (printedGroup) {
        scene.remove(printedGroup);
        printedGroup = null;
      }
      printedGroup = new THREE.Group();
      scene.add(printedGroup);
      if (nozzle) {
        nozzle.position.set(0, 1, 0);
      }
    }

    function animatePrintStep(deltaTime) {
      if (!currentSliceResult) return false;
      const allLayers = currentSliceResult.layers;
      if (allLayers.length === 0) return false;

      const speed = animationSpeed * 20;
      animationProgress += deltaTime * speed;

      let pathCount = 0;
      let targetLayer = 0;
      let targetPath = null;

      outer: for (let li = 0; li < allLayers.length; li++) {
        const layer = allLayers[li];
        targetLayer = li;
        for (const path of layer.paths) {
          if (path.points.length < 2) { pathCount++; continue; }
          if (pathCount >= Math.floor(animationProgress)) {
            targetPath = path;
            break outer;
          }
          pathCount++;
        }
      }

      const totalLayerPaths = allLayers.reduce((s, l) => s + l.paths.length, 0);
      const currentPathIdx = Math.floor(animationProgress);

      if (targetPath && nozzle) {
        const points = targetPath.points;
        const segmentIndex = Math.floor(
          (animationProgress - Math.floor(animationProgress)) * (points.length - 1)
        );
        const actualIndex = Math.min(segmentIndex, points.length - 1);
        const p = points[actualIndex];
        nozzle.position.set(p.x, p.y + 0.5, p.z);

        if (
          targetPath.type !== 'travel' &&
          actualIndex > 0 &&
          window._lastPathIdx !== currentPathIdx
        ) {
          window._lastPathIdx = currentPathIdx;
          const color = targetPath.isError ? 0xe74c3c : targetPath.type === 'support' ? 0xfdcb6e : 0x55efc4;
          const geometry = createLineGeometry([points[actualIndex - 1], p]);
          const material = createLineMaterial(color, 1, targetPath.isError || false);
          material.linewidth = 2;
          const line = new THREE.Line(geometry, material);
          printedGroup.add(line);
        }
      }

      const progress = Math.min(100, (animationProgress / totalLayerPaths) * 100);
      updateProgress(targetLayer, progress);
      return animationProgress < totalLayerPaths;
    }

    function updateProgress(layer, progress) {
      if (currentSliceResult) {
        document.getElementById('currentLayer').textContent = (layer + 1).toString();
        document.getElementById('progress').textContent = progress.toFixed(1) + '%';
      }
    }

    function setStatus(state, text) {
      const statusDot = document.querySelector('.status-dot');
      const statusText = document.getElementById('statusText');

      if (statusDot) {
        statusDot.className = 'status-dot';
        if (state !== 'ready') statusDot.classList.add(state);
      }
      if (statusText) {
        statusText.textContent = text;
        statusText.style.color = state === 'error' ? '#fab1a0' : 
                                 state === 'warning' ? '#fdcb6e' : 
                                 state === 'working' ? '#74b9ff' : '#55efc4';
      }
    }

    function startAnimationLoop() {
      const animate = () => {
        if (!isPrinting || isPaused) return;
        const currentTime = performance.now();
        const deltaTime = (currentTime - lastTime) / 1000;
        lastTime = currentTime;

        const continuePrinting = animatePrintStep(deltaTime);
        if (!continuePrinting) {
          isPrinting = false;
          setStatus('ready', '打印完成！');
          return;
        }
        animationId = requestAnimationFrame(animate);
      };

      if (animationId) cancelAnimationFrame(animationId);
      animate();
    }

    function loadModel(modelType) {
      setStatus('working', '加载模型中...');
      stopPrinting();

      setTimeout(() => {
        currentModel = generateModel(modelType);
        loadModelToScene(currentModel);
        currentSliceResult = null;
        setStatus('ready', '模型加载完成');
      }, 100);
    }

    function startSlice() {
      if (!currentModel) { setStatus('error', '请先加载模型'); return; }
      setStatus('working', '切片计算中...');
      stopPrinting();

      setTimeout(() => {
        currentSliceResult = sliceModel(currentModel, parameters);

        document.getElementById('totalLayers').textContent = currentSliceResult.layers.length.toString();
        document.getElementById('gcodeCount').textContent = currentSliceResult.totalGcodeLines.toString();
        document.getElementById('travelDistance').textContent = currentSliceResult.totalTravelDistance.toFixed(1);

        showPaths(currentSliceResult);
        setStatus('ready', '切片完成，可开始打印');
      }, 100);
    }

    function startPrint() {
      if (!currentSliceResult) { setStatus('error', '请先进行切片'); return; }
      if (isPaused) {
        isPaused = false;
        setStatus('working', '继续打印...');
        lastTime = performance.now();
        startAnimationLoop();
        return;
      }

      resetAnimation();
      clearPaths();
      isPrinting = true;
      isPaused = false;
      setStatus('working', '开始打印...');
      lastTime = performance.now();
      startAnimationLoop();
    }

    function togglePause() {
      if (!isPrinting) return;
      isPaused = !isPaused;
      if (isPaused) setStatus('warning', '打印已暂停');
      else {
        setStatus('working', '继续打印...');
        lastTime = performance.now();
        startAnimationLoop();
      }
    }

    function stopPrinting() {
      isPrinting = false;
      isPaused = false;
      if (animationId) cancelAnimationFrame(animationId);
    }

    function resetScene() {
      stopPrinting();
      resetAnimation();
      if (currentModel) loadModelToScene(currentModel);
      if (currentSliceResult) showPaths(currentSliceResult);
      document.getElementById('currentLayer').textContent = '0';
      document.getElementById('progress').textContent = '0%';
      setStatus('ready', '场景已重置');
    }

    function loadPreset(presetId) {
      const preset = PRESETS[presetId];
      if (!preset) return;

      setStatus('working', '加载预设...');
      stopPrinting();

      setTimeout(() => {
        parameters = { ...DEFAULT_PARAMS, ...preset };

        document.getElementById('layerHeight').value = preset.layerHeight;
        document.getElementById('layerHeightValue').textContent = preset.layerHeight.toFixed(2);
        document.getElementById('infillDensity').value = preset.infillDensity;
        document.getElementById('infillDensityValue').textContent = preset.infillDensity;
        document.getElementById('printSpeed').value = preset.printSpeed;
        document.getElementById('printSpeedValue').textContent = preset.printSpeed;
        document.getElementById('supportStyle').value = preset.supportStyle;
        document.getElementById('modelSelect').value = preset.model;

        loadModel(preset.model);
        setTimeout(() => startSlice(), 200);
      }, 100);
    }

    function initScene() {
      const container = document.getElementById('canvas-container');
      const width = container.clientWidth;
      const height = container.clientHeight;

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0a0a15);

      camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 1000);
      camera.position.set(5, 5, 8);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(window.devicePixelRatio);
      renderer.shadowMap.enabled = true;
      container.appendChild(renderer.domElement);

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.target.set(0, 0, 0);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
      directionalLight.position.set(10, 20, 10);
      directionalLight.castShadow = true;
      scene.add(directionalLight);

      const pointLight1 = new THREE.PointLight(0x74b9ff, 0.5);
      pointLight1.position.set(-5, 5, -5);
      scene.add(pointLight1);

      const bedGeometry = new THREE.PlaneGeometry(10, 10);
      const bedMaterial = new THREE.MeshStandardMaterial({ color: 0x2d3436, roughness: 0.8, metalness: 0.2 });
      const bed = new THREE.Mesh(bedGeometry, bedMaterial);
      bed.rotation.x = -Math.PI / 2;
      bed.position.y = -1.5;
      bed.receiveShadow = true;
      scene.add(bed);

      const gridHelper = new THREE.GridHelper(10, 20, 0x4a5568, 0x4a5568);
      gridHelper.position.y = -1.49;
      scene.add(gridHelper);

      const nozzleGroup = new THREE.Group();
      const coneGeometry = new THREE.ConeGeometry(0.1, 0.3, 16);
      const coneMaterial = new THREE.MeshStandardMaterial({ color: 0xff6b6b, metalness: 0.8, roughness: 0.2 });
      const cone = new THREE.Mesh(coneGeometry, coneMaterial);
      cone.rotation.x = Math.PI;
      cone.position.y = -0.15;
      nozzleGroup.add(cone);

      const tipGeometry = new THREE.CylinderGeometry(0.02, 0.02, 0.2, 8);
      const tipMaterial = new THREE.MeshStandardMaterial({ color: 0xff4444, emissive: 0xff0000, emissiveIntensity: 0.5 });
      const tip = new THREE.Mesh(tipGeometry, tipMaterial);
      tip.position.y = -0.3;
      nozzleGroup.add(tip);

      const nozzleLight = new THREE.PointLight(0xff6b6b, 1, 2);
      nozzleLight.position.y = -0.3;
      nozzleGroup.add(nozzleLight);

      nozzle = nozzleGroup;
      nozzle.position.set(0, 1, 0);
      scene.add(nozzle);

      printedGroup = new THREE.Group();
      scene.add(printedGroup);

      window.addEventListener('resize', () => {
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });

      function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
      }
      animate();
    }

    function setupEventListeners() {
      document.getElementById('importModel').addEventListener('click', () => {
        const select = document.getElementById('modelSelect');
        loadModel(select.value);
      });

      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const presetId = e.currentTarget.dataset.preset;
          if (presetId) loadPreset(presetId);
        });
      });

      document.getElementById('startSlice').addEventListener('click', startSlice);
      document.getElementById('startPrint').addEventListener('click', startPrint);
      document.getElementById('pausePrint').addEventListener('click', togglePause);
      document.getElementById('resetScene').addEventListener('click', resetScene);

      document.getElementById('layerHeight').addEventListener('input', (e) => {
        parameters.layerHeight = parseFloat(e.target.value);
        document.getElementById('layerHeightValue').textContent = parameters.layerHeight.toFixed(2);
      });

      document.getElementById('infillDensity').addEventListener('input', (e) => {
        parameters.infillDensity = parseInt(e.target.value);
        document.getElementById('infillDensityValue').textContent = parameters.infillDensity.toString();
      });

      document.getElementById('printSpeed').addEventListener('input', (e) => {
        parameters.printSpeed = parseInt(e.target.value);
        document.getElementById('printSpeedValue').textContent = parameters.printSpeed.toString();
      });

      document.getElementById('supportStyle').addEventListener('change', (e) => {
        parameters.supportStyle = e.target.value;
      });

      document.getElementById('animationSpeed').addEventListener('input', (e) => {
        animationSpeed = parseFloat(e.target.value);
        document.getElementById('animationSpeedValue').textContent = animationSpeed.toFixed(1) + 'x';
      });

      const checkboxes = {
        showModel: 'model',
        showSlices: 'slices',
        showPaths: 'paths',
        showSupports: 'supports',
        showInfill: 'infill',
        showErrors: 'errors',
        showNozzle: 'nozzle',
      };

      Object.entries(checkboxes).forEach(([id, key]) => {
        const el = document.getElementById(id);
        el?.addEventListener('change', () => {
          const visible = el.checked;
          if (key === 'model' && modelMesh) modelMesh.visible = visible;
          if (key === 'nozzle' && nozzle) nozzle.visible = visible;
          if (key === 'paths') pathLines.forEach(l => l.visible = visible);
          if (key === 'supports') supportLines.forEach(l => l.visible = visible);
          if (key === 'infill') infillLines.forEach(l => l.visible = visible);
          if (key === 'errors') errorLines.forEach(l => l.visible = visible);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initScene();
      setupEventListeners();
      loadModel('cube');
    });
</script>
