{
  "name": "web-font-subsetter-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,magenta \"npm:dev:ui\" \"npm:dev:api\"",
    "dev:ui": "cd app && vite dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "cd app && vite build",
    "preview": "cd app && vite preview",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "sql.js": "^1.10.3",
    "fastify": "^4.28.1",
    "fontkit": "^2.0.4",
    "nanoid": "^5.0.7",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "vite-plugin-solid": "^2.10.2",
    "@types/fontkit": "^2.0.7",
    "@types/node": "^22.7.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "solid-js": "^1.9.2",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vinxi": "^0.4.3",
    "vite": "^5.4.8"
  }
}
