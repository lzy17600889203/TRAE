{
  "name": "regex-debugger-visualizer",
  "version": "1.0.0",
  "description": "Visual Regex Debugger & Visualizer with FSM-based analysis",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.1",
    "sql.js": "^1.10.3",
    "vue": "^3.4.15",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "vite": "^5.0.12",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.27",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "@types/sql.js": "^1.4.9"
  }
}
